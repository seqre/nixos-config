diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 6772b43bc..a11056d2a 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -25,6 +25,18 @@ struct DebayerParams {
 	float gamma = 1.0;
 	float contrastExp = 1.0;
 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
+
+	/*
+	 * Radial lens shading correction, applied per channel after black
+	 * level subtraction: gain = 1 + k1 r^2 + k2 r^4 + k3 r^6, with r the
+	 * distance from lscCenter (normalised image coordinates) in units of
+	 * lscRadius pixels. All-zero coefficients disable the correction.
+	 */
+	float lscCenter[2] = { 0.5f, 0.5f };
+	float lscRadius = 1.0f;
+	RGB<float> lscK1 = RGB<float>({ 0.0, 0.0, 0.0 });
+	RGB<float> lscK2 = RGB<float>({ 0.0, 0.0, 0.0 });
+	RGB<float> lscK3 = RGB<float>({ 0.0, 0.0, 0.0 });
 };
 
 } /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 000000000..3ae4ac003
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Radial lens shading correction for the soft ISP (local addition)
+ *
+ * Tuning data:
+ *   - Lsc:
+ *       center: [ x, y ]     # optical centre, normalised image coordinates
+ *       radius: r            # pixels, unit of the polynomial's radius
+ *       strength: s          # optional, scales the correction (default 1)
+ *       k1: [ r, g, b ]      # gain = 1 + k1 r^2 + k2 r^4 + k3 r^6
+ *       k2: [ r, g, b ]
+ *       k3: [ r, g, b ]
+ */
+
+#include "lsc.h"
+
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	auto center = tuningData["center"].get<std::vector<float>>();
+	if (center && center->size() == 2) {
+		center_[0] = (*center)[0];
+		center_[1] = (*center)[1];
+	}
+
+	radius_ = tuningData["radius"].get<float>(1.0f);
+	if (radius_ <= 0.0f) {
+		LOG(IPASoftLsc, Error) << "Invalid radius " << radius_;
+		return -EINVAL;
+	}
+
+	float strength = tuningData["strength"].get<float>(1.0f);
+
+	static const char *const names[] = { "k1", "k2", "k3" };
+	for (unsigned int i = 0; i < 3; i++) {
+		auto k = tuningData[names[i]].get<std::vector<float>>();
+		if (!k)
+			continue;
+		if (k->size() != 3) {
+			LOG(IPASoftLsc, Error) << names[i] << " must have 3 values";
+			return -EINVAL;
+		}
+		k_[i] = RGB<float>({ (*k)[0], (*k)[1], (*k)[2] }) * strength;
+	}
+
+	LOG(IPASoftLsc, Debug)
+		<< "centre " << center_[0] << "," << center_[1]
+		<< " radius " << radius_ << " k1 " << k_[0]
+		<< " k2 " << k_[1] << " k3 " << k_[2];
+
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lscCenter[0] = center_[0];
+	params->lscCenter[1] = center_[1];
+	params->lscRadius = radius_;
+	params->lscK1 = k_[0];
+	params->lscK2 = k_[1];
+	params->lscK3 = k_[2];
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/lsc.h b/src/ipa/simple/algorithms/lsc.h
new file mode 100644
index 000000000..29a9c3b03
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Radial lens shading correction for the soft ISP (local addition)
+ */
+
+#pragma once
+
+#include <array>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	float center_[2] = { 0.5f, 0.5f };
+	float radius_ = 1.0f;
+	std::array<RGB<float>, 3> k_ = { RGB<float>({ 0.0, 0.0, 0.0 }),
+					 RGB<float>({ 0.0, 0.0, 0.0 }),
+					 RGB<float>({ 0.0, 0.0, 0.0 }) };
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
