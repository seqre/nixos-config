index 73c637220..c9f6e5590 100644
--- a/src/ipa/simple/algorithms/meson.build
+++ b/src/ipa/simple/algorithms/meson.build
@@ -6,4 +6,5 @@ soft_simple_ipa_algorithms = files([
     'agc.cpp',
     'blc.cpp',
     'ccm.cpp',
+    'lsc.cpp',
 ])
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 0b641a5f3..27c0b8be6 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,11 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform vec2 lsc_center;
+uniform float lsc_radius;
+uniform vec3 lsc_k1;
+uniform vec3 lsc_k2;
+uniform vec3 lsc_k3;
 
 float apply_contrast(float value)
 {
@@ -232,6 +237,11 @@ void main(void)
 	 */
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+	/* Radial lens shading correction, a no-op when the coefficients are 0 */
+	vec2 lsc_d = (center_pixel - lsc_center * tex_size) / lsc_radius;
+	float lsc_r2 = dot(lsc_d, lsc_d);
+	rgb *= vec3(1.0) + lsc_r2 * (lsc_k1 + lsc_r2 * (lsc_k2 + lsc_r2 * lsc_k3));
+
 	/* Apply AWB gains, and saturate each channel at sensor range */
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 02651fe87..4412bc1f9 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -121,6 +121,11 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lscCenterUniform_ = glGetUniformLocation(programId_, "lsc_center");
+	lscRadiusUniform_ = glGetUniformLocation(programId_, "lsc_radius");
+	lscK1Uniform_ = glGetUniformLocation(programId_, "lsc_k1");
+	lscK2Uniform_ = glGetUniformLocation(programId_, "lsc_k2");
+	lscK3Uniform_ = glGetUniformLocation(programId_, "lsc_k3");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -504,6 +509,15 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Lens shading correction
+	 */
+	glUniform2f(lscCenterUniform_, params.lscCenter[0], params.lscCenter[1]);
+	glUniform1f(lscRadiusUniform_, params.lscRadius);
+	glUniform3f(lscK1Uniform_, params.lscK1[0], params.lscK1[1], params.lscK1[2]);
+	glUniform3f(lscK2Uniform_, params.lscK2[0], params.lscK2[1], params.lscK2[2]);
+	glUniform3f(lscK3Uniform_, params.lscK3[0], params.lscK3[1], params.lscK3[2]);
+
 	return;
 }
 
