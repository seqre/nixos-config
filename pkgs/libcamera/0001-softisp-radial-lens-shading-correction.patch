+	GLint lscRadiusUniform_;
+	GLint lscK1Uniform_;
+	GLint lscK2Uniform_;
+	GLint lscK3Uniform_;
+
 	Size nativeOutputSize_;
 	Rectangle window_;
 	std::unique_ptr<SwStatsCpu> stats_;
